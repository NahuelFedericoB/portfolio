{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/lab",
      "destination": "https://frontend-lab-nfb.vercel.app"
    },
    {
      "source": "/lab/",
      "destination": "https://frontend-lab-nfb.vercel.app/"
    },
    {
      "source": "/lab/:path*",
      "destination": "https://frontend-lab-nfb.vercel.app/:path*"
    }
  ]
}